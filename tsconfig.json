{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@solidrt/core",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Setting exclude replaces the node_modules default, so list it too. The
  // target dirs matter because CMake emits fake-.ts dependency files
  // (compiler_depend.ts) under lattice/target build trees. packages/,
  // apps/, and sandbox/ are excluded because they carry their own
  // target-specific tsconfigs (flux-targeted core/components/player
  // vs bun-targeted cli); this root config only covers strays with no
  // nearer config.
  "exclude": ["**/node_modules", "**/target", "packages", "apps", "lattice", "sandbox"]
}
