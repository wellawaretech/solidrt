# lattice/Makefile.linux

# Host-native: dist-linux stages into the package matching the build host
# (linux-x64-gnu on x86_64, linux-arm64-gnu on aarch64).
PKG_LINUX := $(CURDIR)/../packages/$(HOST_PLATFORM)

.PHONY: client runtime dist-linux

# Stage a binary into dist/<host-platform>/.
# $(1) = target subdir (go|runtime), $(2) = profile (release|debug), $(3) = binary name
define stage-bin
	@mkdir -p $(HOST_DIST)
	@cp target/$(1)/$(2)/$(3) $(HOST_DIST)/
	@echo "Staged $(3) into $(HOST_DIST)/"
endef

client: $(DEFAULT_APP_JS)
	@echo "Building SOLIDRT-GO ($(PROFILE)) $(VERSION)"
	$(SOLIDRT_VERSION) cargo build $(CARGO_PROFILE_FLAG) $(GO_FEATURES) --bin solidrt-go --target-dir target/go
	$(call stage-bin,go,$(PROFILE),solidrt-go)

runtime:
	@echo "Building RUNTIME ($(PROFILE)) $(VERSION)"
	$(SOLIDRT_VERSION) cargo build $(CARGO_PROFILE_FLAG) $(RUNTIME_FEATURES) --bin solidrt --target-dir target/runtime
	$(call stage-bin,runtime,$(PROFILE),solidrt)

dist-linux:
	$(MAKE) client
	cp $(HOST_DIST)/solidrt-go $(PKG_LINUX)/solidrt-go
	$(MAKE) -C $(SRT_HOME)/flux flux fluxc
	$(MAKE) -C $(SRT_HOME)/flux fluxrt PROFILE=release-opt
	cp $(HOST_DIST)/flux $(PKG_LINUX)/flux
	cp $(HOST_DIST)/fluxc $(PKG_LINUX)/fluxc
	cp $(HOST_DIST)/fluxrt $(PKG_LINUX)/fluxrt
	$(MAKE) runtime PROFILE=release-opt
	cp $(HOST_DIST)/solidrt $(PKG_LINUX)/solidrt
