# lattice/Makefile.android
#
# Two tiers of Android build:
#   - dev (single ABI): client-android / run-android build for one ANDROID_ABI
#     only, for fast iteration. Default is arm64-v8a; use ANDROID_ABI=x86_64 for
#     the emulator.
#   - dist (fat): dist-android builds every ABI in ANDROID_ABIS into one APK that
#     runs on both real arm64 devices and the x86_64 emulator.

NDK_HOME    ?= /opt/android-ndk
ANDROID_ABI ?= arm64-v8a

# ABIs bundled into the distributed (fat) APK. The single APK carries native
# libs for each, so it runs on both real arm64 devices and the x86_64 emulator.
ANDROID_ABIS = arm64-v8a x86_64

# Comma-separated form of ANDROID_ABIS for gradle's -PsrtAbi (abiFilters).
empty :=
space := $(empty) $(empty)
comma := ,
ANDROID_ABIS_CSV := $(subst $(space),$(comma),$(strip $(ANDROID_ABIS)))

PKG_ANDROID    := $(CURDIR)/../packages/android-arm64-v8a
PKG_ANDROID_32 := $(CURDIR)/../packages/android-armeabi-v7a

RUST_TARGET_arm64-v8a   = aarch64-linux-android
RUST_TARGET_armeabi-v7a = armv7-linux-androideabi
RUST_TARGET_x86_64      = x86_64-linux-android
RUST_TARGET_x86         = i686-linux-android
ANDROID_TARGET          = $(RUST_TARGET_$(ANDROID_ABI))

# NDK sysroot lib dir names (clang triples; armv7 and x86 differ from rust's).
CLANG_TRIPLE_arm64-v8a   = aarch64-linux-android
CLANG_TRIPLE_armeabi-v7a = arm-linux-androideabi
CLANG_TRIPLE_x86_64      = x86_64-linux-android
CLANG_TRIPLE_x86         = i686-linux-android
ANDROID_CLANG_TRIPLE     = $(CLANG_TRIPLE_$(ANDROID_ABI))

# armv7 needs impellers' bindgen_live (see alloy/Cargo.toml) to point at the
# real 32-bit target. Use the bindgen-recognized BINDGEN_EXTRA_CLANG_ARGS_<target>
# suffix (matching Cargo's TARGET env var, hyphens to underscores) rather than
# the plain var: bindgen also runs for host-targeted build units in the same
# build (e.g. rquickjs-macro, a proc-macro crate that always builds for the
# host), and an unscoped value corrupts those instead of just armv7.
# --sysroot is required too: without it, clang's implicit host glibc fallback
# search path still gets appended after the NDK paths, and bionic's headers
# pull in incompatible glibc macros (__GLIBC_USE) through it.
BINDGEN_VAR_armeabi-v7a   = BINDGEN_EXTRA_CLANG_ARGS_armv7_linux_androideabi
BINDGEN_ARGS_armeabi-v7a  = --target=armv7a-linux-androideabi26 --sysroot=$(NDK_HOME)/toolchains/llvm/prebuilt/linux-x86_64/sysroot

ANDROID_DIST  = $(SRT_HOME)/dist/android/$(ANDROID_ABI)
APK_GO_DEBUG  = android/app/build/outputs/apk/go/debug/app-go-debug.apk

GRADLE_WRAPPER_JAR = android/gradle/wrapper/gradle-wrapper.jar

# Dev-server address handed to the launched client as the srt_dev_server intent
# extra; MainActivity forwards it to native argv (--dev-server) and the client
# auto-connects instead of waiting in the launcher's connect UI. A device shares
# a LAN with this host, so the default is this host's own IPv4 on the route to
# the outside world. Override with DEV_SERVER=host:port (an emulator reaches the
# host through its NAT alias, DEV_SERVER=10.0.2.2:34884), or DEV_SERVER= to
# launch without auto-connect. The dev server itself is not started here: run
# `srt server` in the project directory.
DEV_PORT ?= 34884
ifeq ($(findstring apple-darwin,$(HOST_TARGET)),apple-darwin)
HOST_LAN_IP = $(shell ipconfig getifaddr $$(route -n get 1.1.1.1 2>/dev/null | sed -n 's/.*interface: //p') 2>/dev/null)
else
HOST_LAN_IP = $(shell ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p')
endif
DEV_SERVER ?= $(if $(HOST_LAN_IP),$(HOST_LAN_IP):$(DEV_PORT))

.PHONY: client-android run-android run-android-armeabi-v7a dist-android dist-android-armeabi-v7a

# Cross-compile the engine .so via cargo-ndk.
# $(1) = label, $(2) = env vars, $(3) = cargo flags
define ndk-build
	@echo "Building ANDROID $(1) $(VERSION)"
	ANDROID_NDK_HOME=$(NDK_HOME) ANDROID_NDK_ROOT=$(NDK_HOME) \
	  CMAKE_TOOLCHAIN_FILE_$(subst -,_,$(ANDROID_TARGET))=$(CURDIR)/android/cmake/android-abi.toolchain.cmake \
	  CMAKE_ANDROID_ARCH_ABI=$(ANDROID_ABI) \
	  $(if $(BINDGEN_VAR_$(ANDROID_ABI)),$(BINDGEN_VAR_$(ANDROID_ABI))="$(BINDGEN_ARGS_$(ANDROID_ABI))") \
	  $(2) \
	  $(SOLIDRT_VERSION) cargo ndk -t $(ANDROID_ABI) build --lib $(3)
endef

# Stage .so files into dist/android/ for the Gradle project to pick up.
# $(1) = profile (release|debug)
define ndk-stage
	mkdir -p $(ANDROID_DIST)
	cp target/go/$(ANDROID_TARGET)/$(1)/liblattice.so $(ANDROID_DIST)/libmain.so
	cp target/go/$(ANDROID_TARGET)/$(1)/libSDL3.so $(ANDROID_DIST)/
	# copy newest if there are multiple
	cp "$$(ls -t target/go/$(ANDROID_TARGET)/$(1)/build/impellers-*/out/libimpeller.so | head -1)" $(ANDROID_DIST)/
	# whisper-rs links the NDK's shared C++ runtime, so the APK must carry it
	cp $(NDK_HOME)/toolchains/llvm/prebuilt/*/sysroot/usr/lib/$(ANDROID_CLANG_TRIPLE)/libc++_shared.so $(ANDROID_DIST)/
	@echo "Staged Android .so files into $(ANDROID_DIST)/"
endef

client-android: $(LAUNCHER_JS) $(BSOD_JS)
	$(call ndk-build,SOLIDRT-GO ($(PROFILE)),,$(CARGO_PROFILE_FLAG) $(GO_FEATURES) --target-dir target/go)
	$(call ndk-stage,$(PROFILE))

# Bootstrap Gradle wrapper if missing.
$(GRADLE_WRAPPER_JAR):
	cd android && gradle wrapper

# Build APK, install, launch, and stream logcat.
# $(1) = profile (release|debug) matching the staged .so
define android-run
	$(call ndk-stage,$(1))
	# -PsrtAbi keeps a leftover ABI staged under dist/android out of this APK,
	# so the dev loop stays single-ABI (same reason as dist-android).
	cd android && ./gradlew assembleGoDebug -PsrtAbi=$(ANDROID_ABI)
	adb install -r $(APK_GO_DEBUG)
	adb logcat -c
	@echo "Launching with dev server: $(if $(DEV_SERVER),$(DEV_SERVER),none (manual/QR connect))"
	adb shell am start -n com.solidrt.go/com.solidrt.app.MainActivity $(if $(DEV_SERVER),--es srt_dev_server $(DEV_SERVER))
	adb logcat -s SDL SDL/APP libmain DEBUG libc
endef

run-android: client-android $(GRADLE_WRAPPER_JAR)
	$(call android-run,$(PROFILE))

# The same dev loop against the 32-bit ABI (see dist-android-armeabi-v7a).
run-android-armeabi-v7a:
	$(MAKE) run-android ANDROID_ABI=armeabi-v7a PROFILE=$(PROFILE)

dist-android: $(GRADLE_WRAPPER_JAR)
	# Build + stage the engine .so for every bundled ABI into dist/android/<abi>/.
	for abi in $(ANDROID_ABIS); do \
	  $(MAKE) client-android ANDROID_ABI=$$abi PROFILE=$(PROFILE) || exit 1; \
	done
	# Pin the assemble to ANDROID_ABIS via -PsrtAbi so a leftover ABI staged under
	# dist/android (e.g. armeabi-v7a from dist-android-armeabi-v7a) can't leak into
	# the fat APK; gradle's jniLibs.srcDir would otherwise bundle every staged ABI.
	cd android && ./gradlew assembleGoDebug -PsrtAbi="$(ANDROID_ABIS_CSV)"
	mkdir -p $(ANDROID_DIST)
	cp $(APK_GO_DEBUG) $(ANDROID_DIST)/solidrt-go.apk
	cp $(ANDROID_DIST)/solidrt-go.apk $(PKG_ANDROID)/solidrt-go.apk
	@echo "Staged fat solidrt-go.apk ($(ANDROID_ABIS)) into $(ANDROID_DIST)/ and $(PKG_ANDROID)/"

# 32-bit (armeabi-v7a) single-ABI APK staged into packages/android-armeabi-v7a/.
# Unlike the fat dist-android, -PsrtAbi=armeabi-v7a restricts the bundled native
# libs to the one ABI even though dist/android may hold other staged ABIs, so the
# 32-bit package stays 32-bit. SPEECH defaults off everywhere (see Makefile).
dist-android-armeabi-v7a: $(GRADLE_WRAPPER_JAR)
	$(MAKE) client-android ANDROID_ABI=armeabi-v7a PROFILE=$(PROFILE)
	cd android && ./gradlew assembleGoDebug -PsrtAbi=armeabi-v7a
	mkdir -p $(SRT_HOME)/dist/android/armeabi-v7a
	cp $(APK_GO_DEBUG) $(SRT_HOME)/dist/android/armeabi-v7a/solidrt-go.apk
	cp $(SRT_HOME)/dist/android/armeabi-v7a/solidrt-go.apk $(PKG_ANDROID_32)/solidrt-go.apk
	@echo "Staged armeabi-v7a solidrt-go.apk into $(SRT_HOME)/dist/android/armeabi-v7a/ and $(PKG_ANDROID_32)/"
