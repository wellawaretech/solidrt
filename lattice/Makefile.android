# lattice/Makefile.android
#
# Every Android build is single-ABI, selected by ANDROID_ABI (default
# arm64-v8a; ANDROID_ABI=x86_64 for the emulator):
#   - dev: android-client / android-run build and launch the client for fast
#     iteration; android-runtime builds the production runner on its own.
#   - dist: android-dist builds both APKs for one ABI and stages them into
#     packages/android-<abi>/, mirroring the desktop `dist` goal.
#
# The .so files themselves (libmain.so with SDL, impeller and, when a lib
# links it, the NDK's C++ runtime beside it, 16 KB page aligned) are the
# runtime's build (RUNTIME_MAKE android-client / android-runtime), staged
# into dist/android/<abi>/ and dist/android-runtime/<abi>/ for the Gradle
# project here to pick up.
#
# There is no fat APK: every consumer resolves per ABI. `sol android --install`
# picks the APK matching the device's ro.product.cpu.abi, and `sol pack --apk`
# patches a per-ABI runner. Play Store publishing is a separate future artifact
# (an AAB, split per device at delivery), not a fat APK - see
# okf/backlog/standalone-android-apk.md.

# The platform package for the ABI being built. Not every ABI has one (x86_64
# is a dev-only artifact), so the dist goals stage into it only when it exists.
PKG_ANDROID = $(CURDIR)/../packages/android-$(ANDROID_ABI)

ANDROID_DIST       = $(SOLIDRT_HOME)/dist/android/$(ANDROID_ABI)
APK_PLAYER_DEBUG   = android/app/build/outputs/apk/player/debug/app-player-debug.apk
APK_PLAYER_RELEASE = android/app/build/outputs/apk/player/release/app-player-release.apk

GRADLE_WRAPPER_JAR = android/gradle/wrapper/gradle-wrapper.jar

# Dev-server address handed to the launched client as the sol_dev_server intent
# extra; MainActivity forwards it to native argv (--dev-server) and the client
# auto-connects instead of waiting in the player's connect UI. A device shares
# a LAN with this host, so the default is this host's own IPv4 on the route to
# the outside world. Override with DEV_SERVER=host:port (an emulator reaches the
# host through its NAT alias, DEV_SERVER=10.0.2.2:34884), or DEV_SERVER= to
# launch without auto-connect. The dev server itself is not started here: run
# `sol server` in the project directory.
DEV_PORT ?= 34884
ifeq ($(findstring apple-darwin,$(HOST_TARGET)),apple-darwin)
HOST_LAN_IP = $(shell ipconfig getifaddr $$(route -n get 1.1.1.1 2>/dev/null | sed -n 's/.*interface: //p') 2>/dev/null)
else
HOST_LAN_IP = $(shell ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p')
endif
DEV_SERVER ?= $(if $(HOST_LAN_IP),$(HOST_LAN_IP):$(DEV_PORT))

.PHONY: android-client android-run android-run-armeabi-v7a android-dist android-dist-armeabi-v7a

android-client: $(PLAYER_JS) $(BSOD_JS)
	$(RUNTIME_MAKE) android-client

# Bootstrap Gradle wrapper if missing.
$(GRADLE_WRAPPER_JAR):
	cd android && gradle wrapper

# Build APK, stage it into dist/android/<abi>/ next to its .so files, install
# that staged copy, launch, and stream logcat. Staging keeps dist/android
# current with what the device runs, so `sol android --install` (which takes
# the APK from there in a checkout) installs this build, not an older one.
define apk-run
	# gradle's jniLibs.srcDir bundles every ABI staged under dist/android, so
	# -PsolAbi pins the APK to the one this loop just built.
	cd android && ./gradlew assemblePlayerDebug -PsolAbi=$(ANDROID_ABI)
	cp $(APK_PLAYER_DEBUG) $(ANDROID_DIST)/solidrt-go.apk
	@echo "Staged solidrt-go.apk ($(ANDROID_ABI)) into $(ANDROID_DIST)/"
	adb install -r $(ANDROID_DIST)/solidrt-go.apk
	adb logcat -c
	@echo "Launching with dev server: $(if $(DEV_SERVER),$(DEV_SERVER),none (manual/QR connect))"
	adb shell am start -n com.solidrt.player.dev/com.solidrt.app.MainActivity $(if $(DEV_SERVER),--es sol_dev_server $(DEV_SERVER))
	adb logcat -s SDL SDL/APP libmain DEBUG libc
endef

android-run: android-client $(GRADLE_WRAPPER_JAR)
	$(call apk-run)

# The same dev loop against the 32-bit ABI.
android-run-armeabi-v7a:
	$(MAKE) android-run ANDROID_ABI=armeabi-v7a

# Copy a staged APK into the ABI's platform package, when that ABI has one.
# $(1) = staged APK, $(2) = name inside the package
define stage-pkg-apk
	if [ -d $(PKG_ANDROID) ]; then \
	  cp $(1) $(PKG_ANDROID)/$(2); \
	  echo "Staged $(2) ($(ANDROID_ABI)) into $(PKG_ANDROID)/"; \
	else \
	  echo "No platform package for $(ANDROID_ABI); $(2) staged into dist/ only"; \
	fi
endef

# Both distributable APKs for one ABI: the client (solidrt-go.apk) and the
# production runner (solidrt.apk), both at PROFILE like the desktop `dist`
# goal (PROFILE=release-opt for the publish build). SPEECH is forced off (see
# Makefile). The client is the Gradle release build type, not debuggable.
# PUBLISH=1 (the release workflow) makes it the published Player,
# com.solidrt.player signed with the Player key from the environment;
# without it, it is the dev Player (com.solidrt.player.dev, debug key), like
# the dev loop's debuggable build above (app/build.gradle).
android-dist: android-client $(GRADLE_WRAPPER_JAR)
	# dist/android may hold .so files from other ABIs, and gradle's
	# jniLibs.srcDir would bundle all of them; -PsolAbi pins the APK to this one.
	cd android && ./gradlew assemblePlayerRelease -PsolAbi=$(ANDROID_ABI) -PsolVersion=$(VERSION) $(if $(PUBLISH),-PsolPublish)
	mkdir -p $(ANDROID_DIST)
	cp $(APK_PLAYER_RELEASE) $(ANDROID_DIST)/solidrt-go.apk
	@echo "Staged solidrt-go.apk ($(ANDROID_ABI)) into $(ANDROID_DIST)/"
	$(call stage-pkg-apk,$(ANDROID_DIST)/solidrt-go.apk,solidrt-go.apk)
	$(MAKE) android-runtime ANDROID_ABI=$(ANDROID_ABI)
	if [ -d $(PKG_ANDROID) ]; then $(call stage-notices,$(ANDROID_TARGET),$(PKG_ANDROID)); fi

# The same, for the 32-bit ABI.
android-dist-armeabi-v7a:
	$(MAKE) android-dist ANDROID_ABI=armeabi-v7a

# -- Production runtime APK ---------------------------

# Where the runtime .so files and the runner APK are staged; the runner
# flavor's jniLibs.srcDir in app/build.gradle points here. Kept apart from
# dist/android so go and runtime builds of the same ABI never overwrite each
# other's libmain.so.
ANDROID_RUNTIME_DIST = $(SOLIDRT_HOME)/dist/android-runtime

APK_RUNNER_RELEASE = android/app/build/outputs/apk/runner/release/app-runner-release.apk

.PHONY: android-runtime

# Build the production Android runtime: the not(go) engine .so (no player,
# no dev server; SDL_main boots the .solapp packed into the APK) assembled
# into the runner flavor as the runner APK `sol pack --apk` patches. Same
# feature set as the desktop runtime. It builds at PROFILE, whether on its
# own (the dev loop for the runner) or from android-dist. Runners are per ABI
# by decision (okf/done/standalone-android-apk.md). The Gradle side is the
# release build type: a debug build is debuggable, which lets `adb shell
# run-as` read a packed app's private files
# (okf/done/packed-apk-data-on-device.md); the release type signs with the
# same checked-in debug keystore.
android-runtime: $(BSOD_JS) $(GRADLE_WRAPPER_JAR)
	$(RUNTIME_MAKE) android-runtime
	cd android && ./gradlew assembleRunnerRelease -PsolAbi=$(ANDROID_ABI)
	cp $(APK_RUNNER_RELEASE) $(ANDROID_RUNTIME_DIST)/$(ANDROID_ABI)/solidrt.apk
	@echo "Staged solidrt.apk ($(ANDROID_ABI)) into $(ANDROID_RUNTIME_DIST)/$(ANDROID_ABI)/"
	# The runner rides in the same platform package as solidrt-go.apk.
	$(call stage-pkg-apk,$(ANDROID_RUNTIME_DIST)/$(ANDROID_ABI)/solidrt.apk,solidrt.apk)
