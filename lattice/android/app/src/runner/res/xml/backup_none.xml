<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11 (fullBackupContent): nothing leaves the device. A rule
     set with only excludes still backs up "everything else", so every domain
     is excluded at its root. The data-only counterpart is backup_data.xml;
     srt pack swaps this file's bytes for it when the app opts in. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
