<?xml version="1.0" encoding="utf-8"?>
<!-- (108 - 66 * 0.9) / 2 / 108: pulls the full foreground PNG into the
     adaptive icon safe zone at 90% of it, so no launcher mask (circle,
     squircle, rounded rect) ever cuts it and the art does not touch the
     mask edge. Android scales; the patcher never resamples. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/app_icon_fg"
    android:inset="22.5%" />
