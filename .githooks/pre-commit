#!/usr/bin/env bash
# The generated-file checks CI's okf job runs, before the commit instead of
# after the push: a stale okf/index.md or components docs page has been the
# most common red on main. Both checks take well under a second.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
set -eu

cd "$(git rev-parse --show-toplevel)"
bun scripts/build-okf-index.ts --check
bun scripts/build-components-docs.ts --check
