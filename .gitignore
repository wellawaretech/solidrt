target/
node_modules/
dist/
.solidrt-data/

*.db
# Dev sandbox: contents are personal scratch, only the folder convention
# (its tsconfig) is committed. See okf/done/examples-rescope.md.
sandbox/*
!sandbox/tsconfig.json
# Repo tooling lives in scripts/; personal one-offs stay out of git, as do the
# bundles sol writes next to a script it renders.
scripts/personal/
scripts/**/*.sol.js
# Strays from when sol bundle/render wrote bundles next to the entry; sol
# render still writes PNG frames into the cwd.
examples/**/*.sol.js
examples/**/frame-*.png
# The player and BSOD bundles every runtime embeds, the stock program in
# runtime/ included: generated from apps/player by `make player-bundle`
# (make client runs it; runtime/build.rs says so when they are missing) and
# shipped in the CLI package for a custom runtime (docs/runtime).
packages/cli/player/
probes/
scratchpad/
tmp/
spikes/

# make dist / android-dist output staged into the platform packages
packages/*/solidrt*
packages/*/flux*
packages/*/*.dll
packages/*/*.dylib
packages/*/*.apk
frame-00*
packages/*/THIRD-PARTY-NOTICES.txt

# legacy
examples/**/*.srt.js
