#!/usr/bin/env bash
# Render the newest release's sections of CHANGELOG.md to a PNG named after that
# release. changelog-shot.tsx does the work - it captures itself and writes the
# file - so this only picks the destination and runs it.
#
#   ./scripts/changelog/changelog-shot [output-dir] [width]
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$HERE/changelog-shot.tsx"
OUT_DIR="${1:-$HERE}"
WIDTH="${2:-900}"

# The window only has to be at least as tall as the card; the capture is the
# content node's own box, so the extra height never reaches the image.
HEIGHT=4000

# Playback writes a PNG per frame as well. Those are not the output - park them
# in a temp dir rather than beside the one we want. --duration is an upper
# bound: the app exits as soon as it has written its file. The app is a file
# on its own (--file): run from the repo root, a bare path would be refused
# as ambiguous with the root project.
FRAME_DIR="$(mktemp -d)"
trap 'rm -rf "$FRAME_DIR"' EXIT

out="$(bun "$HERE/../../packages/cli/bin/srt" render "$APP" --file \
  --size "${WIDTH}x${HEIGHT}" --fps 4 --duration 5 -o "$FRAME_DIR" \
  -- "$(cd "$OUT_DIR" && pwd)" 2>&1)"

# The app logs the path it wrote; anything else means it never got there.
if ! printf '%s\n' "$out" | grep -q "changelog-shot: wrote "; then
  printf '%s\n' "$out" >&2
  exit 1
fi
printf '%s\n' "$out" | sed -n 's/^changelog-shot: //p'
