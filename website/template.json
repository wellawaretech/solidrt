{
  "page": {
    "template": "file:./template.html",
    "navItem": "<li><a href=\"{href}\">{text}</a></li>",
    "sidebar": "<aside><nav><ul>\n{items}\n</ul></nav></aside>",
    "sidebarItem": "<li><a href=\"{href}\"{current}>{text}</a></li>",
    "sidebarGroup": "<li><a href=\"{href}\"{current}>{text}</a><ul>\n{items}\n</ul></li>"
  },
  "elements": {
    "heading": "<h{depth} id=\"{slug}\">{text}</h{depth}>\n",
    "paragraph": "<p>{text}</p>\n",
    "link": "<a href=\"{href}\">{text}</a>",
    "image": "<img src=\"{href}\" alt=\"{text}\">",
    "code": "<pre><code class=\"hljs language-{lang}\">{text}</code></pre>\n",
    "codespan": "<code>{text}</code>",
    "blockquote": "<blockquote>{text}</blockquote>\n",
    "strong": "<strong>{text}</strong>",
    "em": "<em>{text}</em>"
  }
}
