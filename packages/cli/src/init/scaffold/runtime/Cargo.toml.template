# The app's own runtime: SolidRT's lattice with the modules in src/
# (docs/runtime, "A custom runtime"). `make` builds and stages it into
# dist/, which package.json names as the app's runtime.
[package]
name = "{{crate}}"
version = "0.0.0"
edition = "2021"
publish = false

# Its own cargo workspace, not a member of one above it. Cargo.lock beside
# this file is seeded from the SolidRT release's by sol init and settled by
# the first build: commit it, so a build elsewhere (CI builds --locked)
# resolves the same crates, the JavaScript engine among them, which sol's
# bytecode compiler must match (sol pack checks).
[workspace]

# The Android .so, and the library the two binaries link.
[lib]
crate-type = ["cdylib", "lib"]

# The binaries are src/bin/solidrt.rs and src/bin/solidrt-go.rs (cargo finds
# them by name); the player is the same program behind the `go` feature.
[[bin]]
name = "solidrt-go"
required-features = ["go"]

# The one feature of the crate's own: the player, for the solidrt-go binary
# to require. The capabilities (video, ktx2, wasm) are lattice's default
# features, which the plain dependency line below takes whole: the stock set.
[features]
go = ["lattice/go"]

[dependencies]
# The SolidRT release the app's @solidrt packages are at (sol --version);
# the build refuses a tag that differs from the installed @solidrt/cli.
# To leave a capability out, trim the line: `default-features = false,
# features = ["video", "wasm-native"]`, naming everything the runtime keeps.
lattice = { git = "https://github.com/wellawaretech/solidrt", tag = "v{{version}}" }
