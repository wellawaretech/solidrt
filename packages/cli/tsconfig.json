{
  // Bun-targeted: the cli runs under Bun, so bun types belong here (and only
  // here - their global process/Bun declarations leak program-wide, so no
  // flux-targeted package may share a program with them). Two subtrees are
  // not part of this program: src/server/ is the flux dev server with its
  // own flux-targeted tsconfig, and src/init/scaffold/ ships to scaffolded
  // apps with its own. src/types/ (type-only contracts between the two
  // runtimes) is in both.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  },
  "include": ["src"],
  "exclude": ["src/server", "src/init/scaffold"]
}
