{
  // Bun-targeted: the cli runs under Bun, so bun types belong here (and only
  // here - their global process/Bun declarations leak program-wide, so no
  // flux-targeted package may share a program with them). The scaffold/
  // subtree has its own tsconfig (shipped to scaffolded apps), and server/
  // is the flux dev server with its own flux-targeted tsconfig; neither is
  // part of this program. shared/ (type-only contracts between the two) is
  // in both.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  },
  "include": ["src", "shared"]
}
