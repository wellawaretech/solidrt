{
  // Flux-targeted, like core and components (see packages/components/
  // tsconfig.json): scene is a library layer on core and runs on the flux
  // runtime only.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@solidrt/core",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["@solidrt/flux-types"]
  },
  // tools/ runs under bun (srt tool) and tests/ under bun test, not flux:
  // neither is part of this program, the way the cli keeps its
  // flux-targeted subtrees out of its bun-typed one.
  "include": ["."],
  "exclude": ["tools", "tests"]
}
